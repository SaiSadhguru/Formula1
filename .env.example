# APEX F1 — Environment Configuration

# Server Port (default: 3001)
PORT=3001

# AI Provider Configuration (Keep secret, never prefix with VITE_)
# Option A: OpenAI API Key (e.g. sk-proj-...)
OPENAI_API_KEY=

# Option B: Google Gemini API Key (e.g. AIzaSy...)
GEMINI_API_KEY=

# Note: If no API key is provided, the APEX Engineering Cockpit automatically
# engages the high-fidelity deterministic local rule-based engineering analysis engine.
